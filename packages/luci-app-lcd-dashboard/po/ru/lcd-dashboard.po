msgstr "Фон верхней полосы"

msgid "Top band text"
msgstr "Текст верхней полосы"

msgid "Middle band background"
msgstr "Фон средней полосы"

msgid "Bottom band background"
msgstr "Фон нижней полосы"

msgid "Bottom band text"
msgstr "Текст нижней полосы"

msgid "Active tile"
msgstr "Активная плитка"

msgid "Inactive tile"
msgstr "Неактивная плитка"

