msgid "Upgrade firmware"
msgstr "Обновить прошивку"

msgid "Dismiss"
msgstr "Скрыть"

msgid "Firmware upgrade complete: %s -> %s. Your settings were kept."
msgstr "Обновление прошивки завершено: %s -> %s. Настройки сохранены."

msgid "Firmware upgrade complete. You are now running %s."
msgstr "Обновление прошивки завершено. Текущая версия: %s."

msgid "Firmware update available: %s -> %s"
msgstr "Доступно обновление прошивки: %s -> %s"

msgid "Last checked %s."
msgstr "Последняя проверка: %s."

msgid "This downloads the new firmware and reboots the device. Your settings are kept. The image checksum is verified before flashing. Continue?"
msgstr "Будет загружена новая прошивка и устройство перезагрузится. Ваши настройки сохранятся. Перед прошивкой проверяется контрольная сумма. Продолжить?"

msgid "Cancel"
msgstr "Отмена"

msgid "Upgrade"
msgstr "Обновить"

msgid "Confirm firmware upgrade"
msgstr "Подтвердить обновление прошивки"

msgid "Upgrading..."
msgstr "Обновление..."

msgid "Downloading firmware and verifying checksum..."
msgstr "Загрузка прошивки и проверка контрольной суммы..."

msgid "Checksum verified. Rebooting to apply..."
msgstr "Контрольная сумма верна. Перезагрузка для применения..."

msgid "Download failed - check network and system log."
msgstr "Ошибка загрузки — проверьте сеть и системный журнал."

msgid "Retry upgrade"
msgstr "Повторить обновление"

msgid "Install"
msgstr "Установить"

msgid "A fix for your build is available: %s."
msgstr "Доступно исправление для вашей сборки: %s."

msgid "%d fixes for your build are available."
msgstr "Доступны исправления (%d) для вашей сборки."

msgid "Review and install"
msgstr "Просмотреть и установить"

msgid "Could not save the setting: %s"
msgstr "Не удалось сохранить настройку: %s"

msgid "1 package update is available."
msgstr "Доступно обновление 1 пакета."

msgid "%d package updates are available."
msgstr "Доступно обновлений пакетов: %d."

